# Configuration de l'Application
APP_NAME="Chat WebSocket API"
DEBUG=true

# Configuration de la Base de Données
# Format MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://root:@localhost:3306/chat_db

# Configuration JWT & Sécurité
# Générer une clé secrète sécurisée
SECRET_KEY=supersecretkeythatsshouldbechangedinproduction1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting HTTP
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Rate Limiting WebSocket
WS_RATE_LIMIT_MESSAGES=10
WS_RATE_LIMIT_WINDOW_SECONDS=10
